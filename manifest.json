{
  "manifest_version": 3,
  "name": "IPECS Auto Dialer by Indus Web Agency",
  "version": "1.0.0",
  "description": "IPECS Auto Dialer by Indus Web Agency - import leads, auto-dial UK numbers on iPECS Cloud, tag outcomes, export XLSX.",

  "permissions": ["sidePanel", "storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://one3.ipecs-cloud.co.uk/*",
    "https://*.ipecs-cloud.co.uk/*",
    "https://ipecs-auto-dialer-accounts.vercel.app/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "action": {
    "default_title": "IPECS Auto Dialer by Indus Web Agency",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://one3.ipecs-cloud.co.uk/*",
        "https://*.ipecs-cloud.co.uk/*"
      ],
      "js": ["content/selectors.js", "content/inject.js"],
      "css": ["content/hud.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
